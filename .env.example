# ============================================================
# BIST100 Triple Confirmation Bot — Yapılandırma Şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# Gizli bilgileri .env.example'a yazmayın; .env git'e eklenmemeli.
# ============================================================

# --- API & ID ---
TELEGRAM_BOT_TOKEN=8723195344:AAE1JgfcuPty6Js_l_x9q4uQmJUyEX0Fi2M
TELEGRAM_CHAT_ID=1005952159
# KAP haber süzgeci: Gemini ile kritik mi / puan 1-10 / duyarlılık (sadece 7+ tetikler)
GEMINI_API_KEY=AIzaSyBK2K_7nIQZ4u-Xr_8MEvCYXLsOrJlPCoU

# TradingView (opsiyonel): Giriş yapınca veri çekme daha stabil (Connection timed out azalır)
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# --- Strateji eşikleri ---
EMA_PERIOD=200
BB_PERIOD=20
BB_STD=2.0
KC_PERIOD=20
KC_MULT=1.5
RSI_PERIOD=14
RSI_THRESHOLD=50

# --- Hacim & momentum ---
# Squeeze path: hacim >= 1.2x; Momentum bypass: 2x (RS>1.2). Ort. 4x üstü = tükeniş, işlem açılmaz
VOLUME_MULTIPLIER=1.2
VOLUME_MA_PERIOD=20
MOMENTUM_PERIOD=12

# --- Trade Plan (ATR tabanlı) — Momentum & Trend: TP1'de sadece stop maliyete, TP2 = ATR x 8 ---
ATR_PERIOD=14
STOP_ATR_MULT=2.0
TP1_ATR_MULT=2.0
TP2_ATR_MULT=8.0

# --- Piyasa riski (XU100 < EMA20 iken sadece bu RSI üstü sinyaller) ---
MARKET_RISK_RSI_MIN=55

# --- Risk yönetimi (önerilen lot / pozisyon hesabı) ---
# Lot = (TRADING_CAPITAL * RISK_PCT%) / (Giriş - Stop); her işlemde kasanın RISK_PCT'ini riske et
TRADING_CAPITAL=100000
RISK_PCT=5

# --- Bot ayarları ---
# Tarama aralığı (dakika); sürekli döngüde kullanılabilir
SCAN_INTERVAL_MINUTES=240
# Hisse başına istek arası bekleme (saniye); rate limit / IP engeli için
REQUEST_DELAY=0.5
